# Copy to apps/web/.env.local. All VITE_* values are public.
MAPA_API_PROXY_TARGET=http://127.0.0.1:8001
# Development-only directory containing data/administrativo.pmtiles and its labels GeoJSON.
# Builds always use public/; remote map URLs are configured below.
# The directory stays local and is not included in Git.
MAPA_MAP_ASSETS_DIR=public

# Empty values use the local API proxy and local map assets.
VITE_API_BASE_URL=
VITE_ADMIN_PMTILES_URL=
VITE_ADMIN_LABELS_URL=
